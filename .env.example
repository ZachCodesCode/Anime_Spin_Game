# Optional absolute path to authorized private data. Never use a public asset folder.
ASCENT_CATALOGUE_DATA_DIR=
# Local review server always binds to 127.0.0.1; no public admin endpoint.
ASCENT_REVIEW_PORT=8093
# Read-only history export, only when explicitly authorized; never production write tokens.
ASCENT_HISTORY_READONLY=
TURSO_READONLY_DATABASE_URL=
TURSO_READONLY_AUTH_TOKEN=
# Obtain this checksum independently through the trusted team channel.
ASCENT_CATALOGUE_BUNDLE_SHA256=
