{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "associations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operationId": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "actor": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                },
                "before": {},
                "after": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "revision": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "status": {
                      "enum": [
                        "proposed",
                        "needs_review",
                        "verified",
                        "rejected"
                      ]
                    },
                    "claim": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "characterId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "traitId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": [
                            "string",
                            "boolean",
                            "number"
                          ]
                        },
                        "context": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "animeId": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "scope": {
                              "type": "string",
                              "minLength": 1
                            },
                            "persistence": {
                              "enum": [
                                "permanent",
                                "recurring",
                                "temporary",
                                "transformation_specific",
                                "unknown"
                              ]
                            },
                            "form": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "animeId",
                            "scope",
                            "persistence",
                            "form"
                          ]
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "url": {
                                "type": "string",
                                "format": "uri"
                              },
                              "sourceName": {
                                "type": "string",
                                "minLength": 1
                              },
                              "explanation": {
                                "type": "string",
                                "minLength": 1
                              },
                              "kind": {
                                "enum": [
                                  "official",
                                  "secondary",
                                  "community",
                                  "dataset"
                                ]
                              },
                              "accessedAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "required": [
                              "url",
                              "sourceName",
                              "explanation",
                              "kind",
                              "accessedAt"
                            ]
                          }
                        },
                        "provenance": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "provider": {
                              "type": "string",
                              "minLength": 1
                            },
                            "externalCharacterId": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "uncertainty": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "provider",
                            "externalCharacterId",
                            "uncertainty"
                          ]
                        }
                      },
                      "required": [
                        "characterId",
                        "traitId",
                        "value",
                        "context",
                        "evidence",
                        "provenance"
                      ]
                    }
                  },
                  "required": [
                    "revision",
                    "status",
                    "claim"
                  ]
                }
              },
              "required": [
                "operationId",
                "at",
                "actor",
                "note",
                "before",
                "after"
              ]
            }
          }
        },
        "required": [
          "id",
          "history"
        ]
      }
    }
  },
  "required": [
    "version",
    "associations"
  ]
}
