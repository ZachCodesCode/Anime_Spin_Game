{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "enum": [
          "appearance",
          "identity",
          "occupation",
          "ability",
          "affiliation"
        ]
      },
      "valueType": {
        "enum": [
          "string",
          "boolean",
          "number"
        ]
      },
      "allowedValues": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "boolean",
            "number"
          ]
        }
      },
      "guidance": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "label",
      "category",
      "valueType",
      "allowedValues",
      "guidance"
    ]
  }
}
