{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anime-ascent-public-character-v1",
  "title": "Public source-assertion character record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "aliases",
    "appearances",
    "canonicalAppearances",
    "providerIds",
    "sourceProvider",
    "canonicalId",
    "identityStatus",
    "facts",
    "identitySources",
    "formLinks",
    "independentlyVerified",
    "publicationAuthorized",
    "ambiguousCanonicalName"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(acdb-character-[0-9]+|wikidata-character-Q[0-9]+)$"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "providerIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sourceProvider": {
      "enum": [
        "ACDB",
        "Wikidata"
      ]
    },
    "canonicalId": {
      "type": "null"
    },
    "identityStatus": {
      "const": "source_identity"
    },
    "canonicalAppearances": {
      "type": "array",
      "maxItems": 0
    },
    "appearances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "sourceProvider",
          "sourceId",
          "media"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sourceProvider": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "media": {
            "const": "anime"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "characterId",
          "traitId",
          "value",
          "sourceEvidence",
          "independentlyVerified",
          "publicationAuthorized"
        ],
        "properties": {
          "characterId": {
            "type": "string"
          },
          "traitId": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "sourceEvidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "traitId",
                "value",
                "characterId",
                "providerId",
                "sourceProvider",
                "sourceType",
                "acquisition",
                "license",
                "url",
                "context",
                "trustStatus",
                "independentlyVerified",
                "publicationAuthorized",
                "hold"
              ],
              "properties": {
                "traitId": {
                  "type": "string"
                },
                "characterId": {
                  "type": "string"
                },
                "providerId": {
                  "type": "string"
                },
                "sourceProvider": {
                  "type": "string"
                },
                "sourceType": {
                  "type": "string"
                },
                "acquisition": {
                  "type": "string"
                },
                "license": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "trustStatus": {
                  "type": "string"
                },
                "rawField": {
                  "type": "string"
                },
                "rawLabel": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "property": {
                  "type": "string"
                },
                "statementId": {
                  "type": "string"
                },
                "valueId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "rawValue": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "locator": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "entityRevision": {
                  "type": "integer"
                },
                "context": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "animeId",
                    "form",
                    "persistence",
                    "scope"
                  ],
                  "properties": {
                    "animeId": {
                      "type": "null"
                    },
                    "form": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "persistence": {
                      "const": "unknown"
                    },
                    "scope": {
                      "type": "string"
                    },
                    "temporal": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "start": {
                          "type": "string"
                        },
                        "end": {
                          "type": "string"
                        },
                        "at": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "independentlyVerified": {
                  "const": false
                },
                "publicationAuthorized": {
                  "const": false
                },
                "hold": {
                  "type": "null"
                },
                "relationship": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "targetId",
                    "targetQid"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "targetId": {
                      "type": "string"
                    },
                    "targetQid": {
                      "type": "string"
                    }
                  }
                },
                "normalizationBasis": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "property": {
                      "type": "string"
                    },
                    "statementId": {
                      "type": "string"
                    },
                    "valueId": {
                      "type": "string"
                    },
                    "entityId": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "rank": {
                      "type": "string"
                    },
                    "entityRevision": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "independentlyVerified": {
            "const": false
          },
          "publicationAuthorized": {
            "const": false
          }
        }
      }
    },
    "identitySources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerId",
          "sourceProvider",
          "sourceId",
          "revision",
          "license",
          "acquisition",
          "url"
        ],
        "properties": {
          "providerId": {
            "type": "string"
          },
          "sourceProvider": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "acquisition": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "revision": {
            "type": [
              "string",
              "integer"
            ]
          },
          "externalIds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "myAnimeList": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "uniqueItems": true
              },
              "animeCharactersDatabase": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "formLinks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clone": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "clonetype": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "otherchar": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "independentlyVerified": {
      "const": false
    },
    "publicationAuthorized": {
      "const": false
    },
    "ambiguousCanonicalName": {
      "type": "boolean"
    }
  }
}
