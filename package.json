{
  "name": "shonen-spin",
  "version": "1.0.0",
  "private": true,
  "description": "Shonen Spin — anime roster builder, with a Turso-backed leaderboard.",
  "dependencies": {
    "@libsql/client": "^0.14.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "test": "node --test power-level/*.test.js catalogue/tests/*.test.js",
    "build": "node scripts/build-social-preview.js",
    "predev": "npm run build",
    "catalogue:bootstrap": "node catalogue/team-cli.js bootstrap",
    "catalogue:validate": "node catalogue/team-cli.js validate",
    "catalogue:inspect": "node catalogue/team-cli.js inspect",
    "catalogue:import": "node catalogue/import.js",
    "traits": "node catalogue/traits/cli.js",
    "ascent:generate": "node catalogue/generator/cli.js",
    "ascent:plan": "node power-level/scheduling/cli.js plan",
    "ascent:history-export": "node power-level/scheduling/cli.js export",
    "ascent:integrity": "node power-level/versioning/cli.js check",
    "catalogue:review": "node catalogue/verification/server.js",
    "catalogue:bundle": "node catalogue/team-cli.js bundle",
    "catalogue:traits-import": "node catalogue/traits/importer/cli.js",
    "catalogue:acdb-stage": "python3 -B catalogue/acdb/stage.py"
  }
}
