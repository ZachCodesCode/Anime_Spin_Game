{
  "redirects": [
    {
      "source": "/anime-ascent",
      "destination": "/anime-krillion",
      "permanent": true
    },
    {
      "source": "/anime-ascent/",
      "destination": "/anime-krillion",
      "permanent": true
    },
    {
      "source": "/AnimeAscent",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/AnimeAscent/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/descent",
      "destination": "/descent.html"
    },
    {
      "source": "/descent/",
      "destination": "/descent.html"
    },
    {
      "source": "/spin",
      "destination": "/index.html"
    },
    {
      "source": "/spin/",
      "destination": "/index.html"
    },
    {
      "source": "/AnimeAscent",
      "destination": "/AnimeAscent.html"
    },
    {
      "source": "/AnimeAscent/",
      "destination": "/AnimeAscent.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/ascent.js": {
      "includeFiles": "power-level/versioning/releases/**"
    }
  }
}
